<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No static web assets of our own, and none collected from BTCPay Server: with the switch set here instead of
         as a global property on the reference, every BTCPay project builds once (the plugin-builder hit a file race). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- xUnit1051 asks for TestContext cancellation tokens on every call; the host test has its own deadlines. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>BTCPayServer.Plugins.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.Chains\BTCPayServer.Plugins.Chains.csproj" />
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.Neo\BTCPayServer.Plugins.Neo.csproj" />
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.BNBChain\BTCPayServer.Plugins.BNBChain.csproj" />
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.NEAR\BTCPayServer.Plugins.NEAR.csproj" />
    <ProjectReference Include="..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- CVE-2026-118747 (GHSA-vmv3-wvjp-wqpj): BTCPay Server 2.4.7 brings System.Formats.Cbor 9.0.0 through Fido2 4.3.1;
         the BTCPay Server run here uses the patched build. Remove once the submodule carries the fix. -->
    <PackageReference Include="System.Formats.Cbor" Version="9.0.24" />
  </ItemGroup>

</Project>
