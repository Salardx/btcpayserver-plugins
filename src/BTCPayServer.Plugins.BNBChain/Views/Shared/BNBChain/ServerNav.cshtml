@using BTCPayServer.Client
@using BTCPayServer.Plugins.BNBChain
@using BTCPayServer.Plugins.Chains
@inject ChainPluginContext<BNBChainPlugin> Plugin
@{
    var activePage = ViewData.TryGetValue("ActivePage", out var page) ? page?.ToString() : null;
}
@foreach (var chain in Plugin.Chains)
{
    <li permission="@Policies.CanModifyServerSettings">
        <a class="dropdown-item @(activePage == $"{Plugin.PluginId}-{chain.Id}" ? "active" : "")"
           asp-controller="UIBNBChainServer" asp-action="GetServerConfig" asp-route-chainId="@chain.Id">@chain.DisplayName</a>
    </li>
}
