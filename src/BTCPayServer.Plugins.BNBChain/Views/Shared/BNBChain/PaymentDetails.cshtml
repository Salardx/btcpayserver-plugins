@using System.Globalization
@using BTCPayServer.Payments
@using BTCPayServer.Plugins.BNBChain
@using BTCPayServer.Plugins.Chains
@using BTCPayServer.Plugins.Chains.Payments
@using BTCPayServer.Services
@using BTCPayServer.Services.Invoices
@model BTCPayServer.Models.InvoicingModels.InvoiceDetailsModel
@inject PaymentMethodHandlerDictionary Handlers
@inject TransactionLinkProviders TransactionLinks
@inject ChainPluginContext<BNBChainPlugin> Plugin
@{
    var payments = Model.Payments
        .Where(p => Handlers.TryGetValue(p.PaymentMethodId, out var h) && h is IChainPaymentMethodHandler chainHandler && chainHandler.PluginId == Plugin.PluginId)
        .ToArray();
}
@if (payments.Length > 0)
{
    <section>
        <h5>@Plugin.Definition.DisplayName payments</h5>
        <table class="table table-hover" data-testid="@(Plugin.PluginId.ToLowerInvariant())-payment-details">
            <thead><tr><th>Method</th><th>Address</th><th>Transaction</th><th>Block</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var payment in payments)
            {
                var handler = (IChainPaymentMethodHandler)Handlers[payment.PaymentMethodId];
                var details = handler.ParsePaymentDetails(payment.Details);
                <tr>
                    <td>@payment.PaymentMethodId</td>
                    <td class="text-break">@details.To</td>
                    <td><a href="@TransactionLinks.GetTransactionLink(payment.PaymentMethodId, payment.Id)" target="_blank" rel="noopener noreferrer">@details.TransactionId</a></td>
                    <td>@details.BlockIndex</td>
                    <td>@payment.Value.ToString("0.########", CultureInfo.InvariantCulture) @handler.Method.Currency</td>
                    <td>@payment.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
